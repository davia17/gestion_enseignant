datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Enseignant {
  id           Int      @id @default(autoincrement())
  matricule    String   @unique
  nom          String
  tauxHoraire  Float
  nombreHeures Float
  createdAt    DateTime @default(now())
}